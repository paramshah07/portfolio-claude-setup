---
import { getEntry } from 'astro:content';

const { site } = (await getEntry('profile', 'main'))!.data;
// The build date is the deploy date, since every deploy rebuilds the page.
const built = new Date();
---

<footer class="relative z-(--z-content) bg-rail px-6 py-6 text-small text-cream/80 md:px-12">
  <div class="mx-auto flex max-w-7xl flex-wrap justify-between gap-2">
    <p>{site.name}</p>
    <p>
      <time datetime={built.toISOString().slice(0, 10)}>
        {built.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}
      </time>
    </p>
  </div>
</footer>
